# Copy to .env and edit as needed. Values here override config/default.yaml.
# Pattern: TRUSTGUARD_<SECTION>_<KEY>

# --- LLM backend ---
TRUSTGUARD_LLM_PROVIDER=ollama            # ollama | openai
TRUSTGUARD_LLM_MODEL=qwen2.5:3b
TRUSTGUARD_LLM_BASE_URL=http://localhost:11434
# For an OpenAI-compatible endpoint (vLLM / LM Studio / llama.cpp server / OpenRouter / OpenAI):
# TRUSTGUARD_LLM_PROVIDER=openai
# TRUSTGUARD_LLM_OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=sk-...                   # key is read from the env var named by llm.api_key_env

# --- Retrieval (set these false on very limited hardware) ---
# TRUSTGUARD_RETRIEVAL_USE_SEMANTIC=true
# TRUSTGUARD_RETRIEVAL_USE_RERANKER=true

# --- Verification ---
# TRUSTGUARD_VERIFICATION_ENTAIL_THRESHOLD=0.55
# TRUSTGUARD_VERIFICATION_STRUCTURED_CLAIMS=false

# --- Middleware ---
# TRUSTGUARD_MIDDLEWARE_MAX_RETRIES=2

# --- Privacy ---
# Store only a SHA-256 hash of each question (no plaintext, no drafts):
# TRUSTGUARD_PRIVACY_LOG_QUERIES=true
# TRUSTGUARD_PRIVACY_STORE_WITHHELD_DRAFTS=true

# --- Offline mode (after models are cached once) ---
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
